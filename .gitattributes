# Normalize line endings: LF in repo, native on checkout for scripts
* text=auto
*.java text
*.py text
*.js text
*.css text
*.html text
*.md text
*.yaml text
*.yml text
*.sql text
*.json text
*.xml text
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.onnx binary
*.gguf binary
